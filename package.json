{
  "name": "responsters",
  "private": true,
  "type": "module",
  "description": "Repo tools: scripts/ and the Playwright UI tests in tests/. The site itself has no build step: Netlify publishes site/ as is.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:shuffle": "playwright test --shuffle --repeat-each=3",
    "test:all-screens": "ALL_SCREENS=1 playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -p .",
    "check-locales": "node scripts/check-locales.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}

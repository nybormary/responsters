{
  "name": "responsters",
  "private": true,
  "type": "module",
  "description": "Mnemozoo / Responsters: the page build (scripts/build-pages.mjs) and the Playwright UI tests in tests/. Netlify runs the build and publishes dist/.",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:preview": "TARGET=preview playwright test",
    "test:prod": "TARGET=production playwright test",
    "test:prod:smoke": "TARGET=production playwright test --grep @smoke",
    "test:shuffle": "playwright test --shuffle --repeat-each=3",
    "test:all-screens": "ALL_SCREENS=1 playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -p .",
    "check-locales": "node scripts/check-locales.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testomatio/reporter": "^2.21.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}

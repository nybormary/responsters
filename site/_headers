# Card images rarely change: let browsers keep them for a week without asking again.
/img/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# security.txt (RSP-137): RFC 9116 asks for plain text in UTF-8.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
